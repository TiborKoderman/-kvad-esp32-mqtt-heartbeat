{
    "uuid": "504b1696-2ad5-4109-ac28-5158965d6675",
    "deviceName": "esp32s3_hb",

    "modules": {
        "wifi": {
            "enabled": true,
            "sta": {
                "ssid": "YourSSID",
                "password": "YourPassword"
            }
        },
        "mqtt": {
            "enabled": true,
            "host": "mqtt.example.com"
        }
    },

    "services": {
        "heartbeat": {
            "enabled": true,
            "transport": {
                "mqtt": {
                    "topic": "device/{deviceId}/heartbeat",
                    "qos": 1,
                    "retain": false
                }
            },
            "intervalSec": 60,
            "jitterSec": 10,
            "payload": {
                "location": "office",
                "deviceType": "sensor"
            }
        }
    }
}
